# Brief2Build AI — Environment Configuration
# Copy this file to .env and provide your actual values (DO NOT commit .env!)

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Google Gemini API Key (keep private on backend only)
GOOGLE_API_KEY=your_google_api_key_here
# Alternative/Legacy variable name:
GEMINI_API_KEY=your_google_api_key_here

# Gemma 4 Model Identifier (Official multimodal model: gemma-4-26b-a4b-it)
GEMMA_MODEL_ID=gemma-4-26b-a4b-it
# Alternative variable name:
GEMMA_MODEL=gemma-4-26b-a4b-it
